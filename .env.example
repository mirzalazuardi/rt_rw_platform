# Database
DATABASE_URL=sqlite://app.db          # or postgres://user:pass@host:5432/db in production

# Redis (Asynq broker)
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
TELEGRAM_BOT_TOKEN=                   # from @BotFather
TELEGRAM_BOT_SECRET=                  # HMAC secret for initData validation, set in @BotFather

# VIDA Sign (encrypted at rest in officials table)
VIDA_API_KEY=                         # VIDA Sign e-Meterai API key

# Payment Gateways
MIDTRANS_SERVER_KEY=                  # Midtrans server key (sandbox or production)
XENDIT_SECRET_KEY=                    # Xendit secret key (fallback)

# Rodauth
SESSION_SECRET=                       # long random string for cookie signing, use `openssl rand -hex 64`
SMTP_URL=                             # e.g. smtp://user:pass@smtp.example.com:587

# Go Worker (Ruby → Go HTTP bridge)
WORKER_ENQUEUE_URL=http://localhost:8080/enqueue
WORKER_SECRET=                        # shared secret for Ruby→Go HTTP calls
